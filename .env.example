# Database (SQLite default for zero-config local run)
DATABASE_URL=sqlite:///./recruitment.db

# Storage & Upload Limits
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# LLM Configuration ('mock' | 'groq' | 'openai' | 'gemini' | 'ollama')
LLM_PROVIDER=mock
LLM_MODEL=default
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings & Vector Index ('local' | 'openai' | 'gemini' | 'ollama')
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-tfidf-dense
VECTOR_STORE=sqlite

# Security & Responsible AI
REQUIRE_AUTH=false
RECRUITER_API_KEY=recruiter-demo-key
